{
  "name": "@servrsit/web",
  "private": true,
  "version": "0.0.0",
  "description": "ServrSit web application — React + TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm --filter @servrsit/contracts run build",
    "prebuild": "pnpm --filter @servrsit/contracts run build",
    "pretypecheck": "pnpm --filter @servrsit/contracts run build",
    "pretest": "pnpm --filter @servrsit/contracts run build",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@servrsit/contracts": "workspace:*",
    "@servrsit/ui": "workspace:*",
    "qrcode-generator": "2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
