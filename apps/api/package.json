{
  "name": "@servrsit/api",
  "private": true,
  "version": "0.0.0",
  "description": "ServrSit API \u2014 Fastify + TypeScript",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @servrsit/contracts --filter @servrsit/ssh --filter @servrsit/ai run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter @servrsit/contracts --filter @servrsit/ssh --filter @servrsit/ai run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/session": "11.1.6",
    "@servrsit/ai": "workspace:*",
    "@servrsit/contracts": "workspace:*",
    "@servrsit/ssh": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "4.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
