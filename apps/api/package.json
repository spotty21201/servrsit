{
  "name": "@servrsit/api",
  "private": true,
  "version": "0.0.0",
  "description": "ServrSit API — Fastify + TypeScript",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter \"@servrsit/api^...\" run build",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm --filter \"@servrsit/api^...\" run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/index.js",
    "pretest": "pnpm --filter \"@servrsit/api^...\" run build",
    "pretypecheck": "pnpm --filter \"@servrsit/api^...\" run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@node-rs/argon2": "2.2.2",
    "@servrsit/ai": "workspace:*",
    "@servrsit/contracts": "workspace:*",
    "@servrsit/domain": "workspace:*",
    "@servrsit/ssh": "workspace:*",
    "@servrsit/store": "workspace:*",
    "@servrsit/worker": "workspace:*",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "4.0.2",
    "otpauth": "9.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
