{
  "name": "@servrsit/ui",
  "private": true,
  "version": "0.0.0",
  "description": "ServrSit design tokens and accessible presentation components",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens/colors.css": "./src/tokens/colors.css",
    "./tokens/typography.css": "./src/tokens/typography.css",
    "./tokens/spacing.css": "./src/tokens/spacing.css",
    "./tokens/index.css": "./src/tokens/index.css"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --noEmit"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  }
}
