{
  "name": "@servrsit/store",
  "private": true,
  "version": "0.0.0",
  "description": "ServrSit persistence: care-loop repository interface and SQLite implementation (ADR-015)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter \"@servrsit/store^...\" run build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter \"@servrsit/store^...\" run build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter \"@servrsit/store^...\" run build",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@servrsit/contracts": "workspace:*",
    "@servrsit/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
